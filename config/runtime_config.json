{
  "profile": "simulation_safe",
  "runtime_mode": "simulation_mode",
  "target_loop_ms": 20,
  "max_cycles_per_second": 50,
  "max_runtime_cycles": 1,
  "headless": false,
  "dashboard_enabled": true,
  "simulation_mode": true,
  "signal_source": "simulated",
  "simulation_scenario": "nominal_focus",
  "simulation_channel_count": 5,
  "simulation_noise_amplitude": 0.02,
  "simulation_dropout_every_cycles": 0,
  "virtual_world_ingress": {
    "endpoint": "structured://local-world",
    "required": true
  },
  "neural_chip_transport": {
    "transport": "simulation_hal",
    "require_ack": true
  },
  "observer_mirror": {
    "enabled": false,
    "endpoint": "observer://disabled",
    "fail_closed": false
  },
  "biometric_source": {
    "source": "none",
    "required": false,
    "minimum_quality": 0.0
  },
  "full_unlocked_diagnostics": false,
  "replay_enabled": false,
  "benchmark_enabled": false,
  "benchmark_cycles": 256,
  "simulated_signal": [0.2, 0.4, 0.6, 0.3, 0.1]
}
