{
  "version": 3,
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Debug",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "DNXR_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "DNXR_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "asan",
      "displayName": "Debug + ASAN + UBSAN",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/asan",
      "cacheVariables": {
        "DNXR_ENABLE_ASAN": "ON",
        "DNXR_ENABLE_UBSAN": "ON",
        "DNXR_ENABLE_TSAN": "OFF"
      }
    },
    {
      "name": "tsan",
      "displayName": "Debug + TSAN",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/tsan",
      "cacheVariables": {
        "DNXR_ENABLE_ASAN": "OFF",
        "DNXR_ENABLE_TSAN": "ON"
      }
    },
    {
      "name": "ubsan",
      "displayName": "Debug + UBSAN",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/ubsan",
      "cacheVariables": {
        "DNXR_ENABLE_UBSAN": "ON"
      }
    }
  ]
}
